import apache_beam as beam
from apache_beam.options.pipeline_options import PipelineOptions, StandardOptions
from apache_beam.transforms.window import FixedWindows
import json
import datetime

# BigQuery table and schema
PROJECT_ID = "your-gcp-project-id"
DATASET_ID = "crypto_dataset"
TABLE_ID = "real_time_prices"
PUBSUB_TOPIC = "projects/your-gcp-project-id/topics/crypto-price-topic"

schema = "timestamp:TIMESTAMP, coin_name:STRING, avg_price:FLOAT, volume:FLOAT"

class ParsePubSubMessage(beam.DoFn):
    def process(self, message):
        data = json.loads(message.decode("utf-8"))
        timestamp = datetime.datetime.utcnow().isoformat()
        coin_name = data.get("coin_name", "unknown")
        price = float(data.get("price", 0.0))
        volume = float(data.get("volume", 0.0))
        return [{
            "timestamp": timestamp,
            "coin_name": coin_name,
            "avg_price": price,
            "volume": volume
        }]

options = PipelineOptions()
options.view_as(StandardOptions).streaming = True

with beam.Pipeline(options=options) as p:
    (p 
     | "Read from PubSub" >> beam.io.ReadFromPubSub(topic=PUBSUB_TOPIC)
     | "Parse JSON messages" >> beam.ParDo(ParsePubSubMessage())
     | "Windowing" >> beam.WindowInto(FixedWindows(60))  # 1-minute windows
     | "Group and Aggregate" >> beam.CombinePerKey(lambda values: sum(values) / len(values))
     | "Write to BigQuery" >> beam.io.WriteToBigQuery(
            f"{PROJECT_ID}:{DATASET_ID}.{TABLE_ID}",
            schema=schema,
            write_disposition=beam.io.BigQueryDisposition.WRITE_APPEND
        )
    )
